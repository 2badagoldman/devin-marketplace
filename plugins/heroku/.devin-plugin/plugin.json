{
  "name": "heroku",
  "displayName": "Heroku",
  "description": "Deploy Heroku apps, manage dynos, pipelines, add-ons, and Postgres databases, and inspect logs",
  "shortDescription": "Apps, deployments and platform logs",
  "homepage": "https://www.heroku.com",
  "logo": "logo.svg",
  "keywords": [
    "Cloud & Infrastructure"
  ],
  "mcpServers": {
    "heroku": {
      "command": "npx",
      "args": [
        "-y",
        "@heroku/mcp-server"
      ],
      "env": {
        "HEROKU_API_KEY": "${HEROKU_API_KEY}"
      }
    }
  }
}
