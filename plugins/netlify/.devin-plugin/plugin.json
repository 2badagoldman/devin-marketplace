{
  "name": "netlify",
  "displayName": "Netlify",
  "description": "Deploy Netlify projects and manage access controls, extensions, and forms",
  "shortDescription": "Web projects, deployments and settings",
  "homepage": "https://www.netlify.com",
  "repository": "https://github.com/netlify/mcp-server",
  "logo": "logo.svg",
  "keywords": [
    "Cloud & Infrastructure"
  ],
  "mcpServers": {
    "netlify": {
      "command": "npx",
      "args": [
        "-y",
        "@netlify/mcp"
      ],
      "env": {
        "NETLIFY_PERSONAL_ACCESS_TOKEN": "${NETLIFY_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
