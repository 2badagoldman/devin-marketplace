{
  "name": "elastic",
  "displayName": "Elastic",
  "description": "Search Elasticsearch logs, metrics, and traces to diagnose service problems",
  "shortDescription": "Elasticsearch logs, metrics and traces",
  "setup": {
    "notice": "Requires Kibana Agent Builder on Elastic 9.2 or later."
  },
  "homepage": "https://www.elastic.co/",
  "logo": "logo.svg",
  "keywords": [
    "Monitoring & Analytics"
  ],
  "mcpServers": {
    "elastic": {
      "url": "https://${KIBANA_HOST}/api/agent_builder/mcp",
      "headers": {
        "Authorization": "ApiKey ${ELASTIC_API_KEY}"
      }
    }
  }
}
